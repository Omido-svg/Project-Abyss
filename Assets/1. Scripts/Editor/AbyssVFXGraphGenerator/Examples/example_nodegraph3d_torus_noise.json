{
  "schemaVersion": "4.0",
  "name": "VFX_NodeGraph3D_Torus_Noise",
  "description": "Torus Mesh 입자가 방사형으로 퍼지고 Time/Sin 수식과 3D Curl Noise를 사용하는 검증 Recipe",
  "buildMode": "NodeGraph3D",
  "requiredCapabilities": ["MeshOutput", "NodeExpressions", "Procedural3D", "TextureFree"],
  "systems": [
    {
      "name": "TorusNoiseParticles",
      "spawnMode": "Burst",
      "capacity": 1024,
      "spawnCount": 96,
      "spawnRate": 24,
      "lifetime": { "min": 0.65, "max": 1.2 },
      "size": { "min": 0.06, "max": 0.12 },
      "positionMode": "Box",
      "spawnBoxExtents": { "x": 0.08, "y": 0.08, "z": 0.08 },
      "velocityMode": "Radial",
      "direction": { "x": 0, "y": 1, "z": 0 },
      "speed": { "min": 2.5, "max": 6.5 },
      "spread": 0.25,
      "gravity": { "x": 0, "y": -1.5, "z": 0 },
      "drag": 0.45,
      "turbulenceEnabled": true,
      "turbulenceIntensity": 1.15,
      "turbulenceFrequency": 1.7,
      "turbulenceDrag": 0.15,
      "turbulenceOctaves": 3,
      "turbulenceRoughness": 0.55,
      "turbulenceLacunarity": 2,
      "startColor": { "r": 0.75, "g": 0.02, "b": 0.01, "a": 1 },
      "blendMode": "Additive",
      "outputMode": "Mesh",
      "proceduralMesh": "Torus",
      "meshAssetPath": "",
      "meshSubAssetName": "",
      "torusMajorRadius": 0.5,
      "torusMinorRadius": 0.08,
      "torusRadialSegments": 48,
      "torusTubeSegments": 12,
      "shaderGraphAssetPath": "",
      "orientationMode": "OrientToVelocity",
      "orientToVelocity": true,
      "sizeExpression": {
        "kind": "Add",
        "valueType": "Float",
        "inputs": [
          { "kind": "LiteralFloat", "valueType": "Float", "floatValue": 0.085 },
          {
            "kind": "Multiply",
            "valueType": "Float",
            "inputs": [
              { "kind": "Sin", "valueType": "Float", "inputs": [{ "kind": "Time", "valueType": "Float" }] },
              { "kind": "LiteralFloat", "valueType": "Float", "floatValue": 0.025 }
            ]
          }
        ]
      },
      "velocityExpression": {
        "kind": "Multiply",
        "valueType": "Vector3",
        "inputs": [
          {
            "kind": "Normalize",
            "valueType": "Vector3",
            "inputs": [
              {
                "kind": "Add",
                "valueType": "Vector3",
                "inputs": [
                  { "kind": "RandomVector3", "valueType": "Vector3", "vectorMin": { "x": -1, "y": -1, "z": -1 }, "vectorMax": { "x": 1, "y": 1, "z": 1 } },
                  {
                    "kind": "Multiply",
                    "valueType": "Vector3",
                    "inputs": [
                      {
                        "kind": "CurlNoise3D",
                        "valueType": "Vector3",
                        "settings": [
                          { "name": "input:Frequency", "valueType": "Float", "floatValue": 1.8 },
                          { "name": "input:Roughness", "valueType": "Float", "floatValue": 0.5 }
                        ],
                        "inputs": [{ "kind": "RandomVector3", "valueType": "Vector3", "vectorMin": { "x": -2, "y": -2, "z": -2 }, "vectorMax": { "x": 2, "y": 2, "z": 2 } }]
                      },
                      { "kind": "LiteralFloat", "valueType": "Float", "floatValue": 0.35 }
                    ]
                  }
                ]
              }
            ]
          },
          { "kind": "RandomFloat", "valueType": "Float", "floatRange": { "min": 2.5, "max": 6.5 } }
        ]
      },
      "customBlocks": [],
      "textureAssetPath": "",
      "materialAssetPath": "",
      "useFlipbook": false,
      "flipbookColumns": 1,
      "flipbookRows": 1,
      "flipbookBlend": false,
      "capabilities": ["MeshOutput", "NodeExpressions", "CurlNoise3D", "OrientToVelocity"]
    }
  ],
  "exposedOverrides": []
}
