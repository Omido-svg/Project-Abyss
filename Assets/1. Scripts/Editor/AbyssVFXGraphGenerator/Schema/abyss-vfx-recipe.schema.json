{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-abyss.local/schemas/abyss-vfx-nodegraph3d-4.3.json",
  "title": "Project Abyss NodeGraph3D + Common HLSL Aura Recipe v4.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "buildMode",
    "requiredCapabilities",
    "systems"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "4.0",
        "4.1",
        "4.2",
        "4.3"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "buildMode": {
      "const": "NodeGraph3D"
    },
    "requiredCapabilities": {
      "type": "array",
      "allOf": [
        {
          "contains": {
            "const": "MeshOutput"
          }
        },
        {
          "contains": {
            "const": "NodeExpressions"
          }
        },
        {
          "contains": {
            "const": "Procedural3D"
          }
        },
        {
          "contains": {
            "const": "TextureFree"
          }
        }
      ],
      "items": {
        "type": "string"
      }
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/system"
      }
    },
    "exposedOverrides": {
      "type": "array",
      "maxItems": 0
    },
    "surfaceAura": {
      "$ref": "#/$defs/surfaceAura"
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b",
        "a"
      ],
      "properties": {
        "r": {
          "type": "number"
        },
        "g": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "a": {
          "type": "number"
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "valueType"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "valueType": {
          "enum": [
            "String",
            "Float",
            "Int",
            "UInt",
            "Bool",
            "Vector3",
            "Color",
            "Enum",
            "Object"
          ]
        },
        "stringValue": {
          "type": "string"
        },
        "floatValue": {
          "type": "number"
        },
        "intValue": {
          "type": "integer"
        },
        "uintValue": {
          "type": "integer",
          "minimum": 0
        },
        "boolValue": {
          "type": "boolean"
        },
        "vectorValue": {
          "$ref": "#/$defs/vector3"
        },
        "colorValue": {
          "$ref": "#/$defs/color"
        },
        "assetPath": {
          "type": "string"
        },
        "subAssetName": {
          "type": "string"
        }
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "LiteralFloat",
            "LiteralVector3",
            "LiteralColor",
            "RandomFloat",
            "RandomVector3",
            "Add",
            "Subtract",
            "Multiply",
            "Divide",
            "Power",
            "Sin",
            "Cos",
            "Abs",
            "Normalize",
            "Length",
            "Clamp",
            "Lerp",
            "Remap",
            "Time",
            "DeltaTime",
            "Attribute",
            "Noise3D",
            "CurlNoise3D",
            "Operator"
          ]
        },
        "valueType": {
          "enum": [
            "Float",
            "Vector2",
            "Vector3",
            "Vector4",
            "Color"
          ]
        },
        "floatValue": {
          "type": "number"
        },
        "vectorValue": {
          "$ref": "#/$defs/vector3"
        },
        "colorValue": {
          "$ref": "#/$defs/color"
        },
        "floatRange": {
          "$ref": "#/$defs/range"
        },
        "vectorMin": {
          "$ref": "#/$defs/vector3"
        },
        "vectorMax": {
          "$ref": "#/$defs/vector3"
        },
        "attributeName": {
          "type": "string"
        },
        "operatorType": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "settings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/setting"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Operator"
              }
            }
          },
          "then": {
            "required": [
              "operatorType"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Attribute"
              }
            }
          },
          "then": {
            "required": [
              "attributeName"
            ]
          }
        }
      ]
    },
    "blockInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expression"
      ],
      "properties": {
        "slotName": {
          "type": "string"
        },
        "slotIndex": {
          "type": "integer",
          "minimum": -1
        },
        "expression": {
          "$ref": "#/$defs/expression"
        }
      }
    },
    "customBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "blockType"
      ],
      "properties": {
        "context": {
          "enum": [
            "Initialize",
            "Update",
            "Output"
          ]
        },
        "blockType": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "settings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/setting"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blockInput"
          }
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "spawnMode",
        "capacity",
        "lifetime",
        "size",
        "positionMode",
        "velocityMode",
        "speed",
        "outputMode",
        "proceduralMesh"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "spawnMode": {
          "enum": [
            "Burst",
            "Rate"
          ]
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "spawnCount": {
          "type": "number",
          "minimum": 0
        },
        "spawnRate": {
          "type": "number",
          "minimum": 0
        },
        "lifetime": {
          "$ref": "#/$defs/range"
        },
        "size": {
          "$ref": "#/$defs/range"
        },
        "positionMode": {
          "enum": [
            "Point",
            "Box"
          ]
        },
        "spawnBoxExtents": {
          "$ref": "#/$defs/vector3"
        },
        "velocityMode": {
          "enum": [
            "None",
            "Radial",
            "Directional"
          ]
        },
        "direction": {
          "$ref": "#/$defs/vector3"
        },
        "speed": {
          "$ref": "#/$defs/range"
        },
        "spread": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gravity": {
          "$ref": "#/$defs/vector3"
        },
        "drag": {
          "type": "number",
          "minimum": 0
        },
        "turbulenceEnabled": {
          "type": "boolean"
        },
        "turbulenceIntensity": {
          "type": "number",
          "minimum": 0
        },
        "turbulenceFrequency": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "turbulenceDrag": {
          "type": "number",
          "minimum": 0
        },
        "turbulenceOctaves": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "turbulenceRoughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "turbulenceLacunarity": {
          "type": "number",
          "minimum": 1
        },
        "startColor": {
          "$ref": "#/$defs/color"
        },
        "blendMode": {
          "enum": [
            "Alpha",
            "Additive",
            "Premultiplied"
          ]
        },
        "outputMode": {
          "const": "Mesh"
        },
        "proceduralMesh": {
          "enum": [
            "Asset",
            "Sphere",
            "Cube",
            "Cylinder",
            "Capsule",
            "Torus",
            "ArcBlade",
            "Shard"
          ]
        },
        "meshAssetPath": {
          "type": "string"
        },
        "meshSubAssetName": {
          "type": "string"
        },
        "torusMajorRadius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "torusMinorRadius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "torusRadialSegments": {
          "type": "integer",
          "minimum": 3,
          "maximum": 256
        },
        "torusTubeSegments": {
          "type": "integer",
          "minimum": 3,
          "maximum": 128
        },
        "shaderGraphAssetPath": {
          "type": "string"
        },
        "orientationMode": {
          "enum": [
            "FixedAxis",
            "OrientToVelocity"
          ]
        },
        "orientToVelocity": {
          "type": "boolean"
        },
        "lifetimeExpression": {
          "$ref": "#/$defs/expression"
        },
        "sizeExpression": {
          "$ref": "#/$defs/expression"
        },
        "positionExpression": {
          "$ref": "#/$defs/expression"
        },
        "velocityExpression": {
          "$ref": "#/$defs/expression"
        },
        "colorExpression": {
          "$ref": "#/$defs/expression"
        },
        "alphaExpression": {
          "$ref": "#/$defs/expression"
        },
        "angleExpression": {
          "$ref": "#/$defs/expression"
        },
        "updateVelocityExpression": {
          "$ref": "#/$defs/expression"
        },
        "updatePositionExpression": {
          "$ref": "#/$defs/expression"
        },
        "customBlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/customBlock"
          }
        },
        "textureAssetPath": {
          "const": ""
        },
        "materialAssetPath": {
          "const": ""
        },
        "useFlipbook": {
          "const": false
        },
        "flipbookColumns": {
          "const": 1
        },
        "flipbookRows": {
          "const": 1
        },
        "flipbookBlend": {
          "const": false
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "proceduralMesh": {
                "const": "Asset"
              }
            }
          },
          "then": {
            "required": [
              "meshAssetPath"
            ],
            "properties": {
              "meshAssetPath": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "surfaceAura": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "shaderFamily": {
          "enum": [
            "SkinnedFlameAura",
            "ShinCurtainAura"
          ]
        },
        "shaderAssetPath": {
          "type": "string"
        },
        "rendererMode": {
          "enum": [
            "BackSilhouette",
            "CameraBackCurtain"
          ]
        },
        "autoBindToParent": {
          "type": "boolean"
        },
        "includeInactiveRenderers": {
          "type": "boolean"
        },
        "previewInEditMode": {
          "type": "boolean"
        },
        "excludedNameContains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "baseColor": {
          "$ref": "#/$defs/color"
        },
        "edgeColor": {
          "$ref": "#/$defs/color"
        },
        "hotColor": {
          "$ref": "#/$defs/color"
        },
        "coreEmission": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "coreOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "coreFresnelPower": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 8
        },
        "innerWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.12
        },
        "flameEmission": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "flameOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "flameFresnelPower": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 8
        },
        "outerWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.35
        },
        "rearOffset": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25
        },
        "flameLift": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.6
        },
        "lateralWobble": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25
        },
        "noiseScale": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 20
        },
        "detailNoiseScale": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 30
        },
        "noiseSpeed": {
          "type": "number",
          "minimum": -5,
          "maximum": 5
        },
        "flameStretch": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 8
        },
        "cutoff": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "edgeSoftness": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.35
        },
        "rearBias": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pulseSpeed": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "pulseAmount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "boundsPadding": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 2
        },
        "emission": {
          "type": "number",
          "minimum": 0,
          "maximum": 12
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fresnelPower": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 8
        },
        "followCamera": {
          "type": "boolean"
        },
        "curtainLayerCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "curtainWidthMultiplier": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        },
        "curtainHeightMultiplier": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        },
        "curtainRearDistance": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "curtainVerticalOffset": {
          "type": "number",
          "minimum": -0.75,
          "maximum": 0.75
        },
        "curtainCurveDepth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "curtainLayerDepthStep": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "curtainLayerScaleStep": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3
        },
        "curtainColumns": {
          "type": "integer",
          "minimum": 4,
          "maximum": 96
        },
        "curtainRows": {
          "type": "integer",
          "minimum": 4,
          "maximum": 96
        },
        "lobeSeparation": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        },
        "lobeWidth": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1.2
        },
        "tipVariation": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.6
        },
        "sideFade": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 0.8
        },
        "bottomFade": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.5
        },
        "depthWobble": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25
        }
      }
    }
  }
}
