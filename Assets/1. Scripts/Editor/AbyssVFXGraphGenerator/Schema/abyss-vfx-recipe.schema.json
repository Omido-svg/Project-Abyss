{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Abyss VFX Recipe",
  "type": "object",
  "required": ["schemaVersion", "name", "systems"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "systems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["name", "spawnMode", "capacity", "lifetime", "size"],
        "properties": {
          "name": { "type": "string" },
          "spawnMode": { "enum": ["Burst", "Rate"] },
          "capacity": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "spawnCount": { "type": "number", "minimum": 0 },
          "spawnRate": { "type": "number", "minimum": 0 },
          "positionMode": { "enum": ["Point", "Box"] },
          "velocityMode": { "enum": ["None", "Radial", "Directional"] },
          "blendMode": { "enum": ["Alpha", "Additive", "Premultiplied"] },
          "textureAssetPath": { "type": "string" }
        }
      }
    }
  }
}
