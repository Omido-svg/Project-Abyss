  "stickyNotes": [
    {
      "id": "usage",
      "title": "Shin Aura Usage",
      "content": "Apply this material to a duplicated SkinnedMeshRenderer such as 'Alpha_Surface shin', not to the original character material. The Vertex branch expands the duplicate mesh along Object-space normals. Back-face additive rendering leaves the irregular golden shell mainly outside the original silhouette.",
      "x": -2300.0,
      "y": -520.0,
      "width": 560.0,
      "height": 190.0,
      "theme": "Classic",
      "textSize": "Medium"
    },
    {
      "id": "tuning",
      "title": "Material Tuning",
      "content": "Start with Shell Width 0.015-0.04 and Flame Height 0.04-0.10. If the shell moves inward, reverse Rise Speed. Use Noise Scale for large tongues and Detail Scale for broken flame edges.",
      "x": 520.0,
      "y": 1600.0,
      "width": 520.0,
      "height": 160.0,
      "theme": "Classic",
      "textSize": "Medium"
    }
