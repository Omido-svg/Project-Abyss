#if UNITY_EDITOR
using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using TMPro;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.SceneManagement;
using UnityEngine.UI;

/// <summary>
/// Project Abyss CameraTest의 기존 전투 로직과 TargetArrowUI를 유지하면서
/// 최종 전투 UI 구조를 한 번만 구축하는 Editor Tool입니다.
/// 성공적으로 적용되면 과거 일회성 Tool들과 이 Installer 자체를
/// .cs.disabled 파일로 보관하여 Tools 메뉴에서 제거합니다.
/// </summary>
public sealed class ProjectAbyssFinalBattleUiInstaller : EditorWindow
{
    private const string MenuPath =
        "Tools/Project Abyss/Build Final Battle UI (One Time)";

    private const string CanvasName = "Battle UI Canvas";
    private const string OldHudName = "ReadableBattleHUD";
    private const string RootName = "AbyssBattleUI";

    private static readonly string[] OneShotToolPaths =
    {
        "Assets/1. Scripts/Editor/Tools/BattleUiReadabilityInstaller.cs",
        "Assets/1. Scripts/Editor/Tools/ProjectAbyssBattleUiRefactorTool.cs",
        "Assets/1. Scripts/Editor/Tools/ProjectAbyssUnusedScriptCleaner.cs",
        "Assets/1. Scripts/Editor/Tools/CombatRuleThreeTurnWalkthrough.cs",
        "Assets/1. Scripts/Editor/Tools/CombatRules20260726LatestMigration.cs"
    };

    private static readonly Color PanelColor =
        new(0.025f, 0.035f, 0.055f, 0.94f);

    private static readonly Color PanelSoftColor =
        new(0.04f, 0.055f, 0.08f, 0.90f);

    private static readonly Color BorderColor =
        new(0.18f, 0.44f, 0.70f, 0.95f);

    private static readonly Color AccentColor =
        new(0.10f, 0.58f, 1f, 1f);

    private Vector2 scroll;
    private bool archiveOldTools = true;
    private bool saveScene = true;
    private bool createBackup = true;
    private bool removeMissingScripts = true;

    [MenuItem(MenuPath, false, 2100)]
    public static void Open()
    {
        ProjectAbyssFinalBattleUiInstaller window =
            GetWindow<ProjectAbyssFinalBattleUiInstaller>();

        window.titleContent = new GUIContent("Final Battle UI");
        window.minSize = new Vector2(620f, 540f);
        window.Show();
    }

    private void OnGUI()
    {
        scroll = EditorGUILayout.BeginScrollView(scroll);

        EditorGUILayout.Space(10f);
        EditorGUILayout.LabelField(
            "Project Abyss 최종 전투 UI 구축",
            EditorStyles.boldLabel);

        EditorGUILayout.HelpBox(
            "현재 TargetArrowUI의 행동 연결 로직은 그대로 유지합니다. " +
            "우측 결투 현황을 좌→우 방향으로 배치하고, 기존 부위 버튼을 " +
            "초상화 카드로 교체하며, 서랍형 스킬 패널·월드 HP 판·" +
            "카메라 전용 상세 패널을 생성합니다.",
            MessageType.Info);

        EditorGUILayout.Space(8f);
        createBackup = EditorGUILayout.ToggleLeft(
            "적용 전 CameraTest Scene 백업 생성",
            createBackup);
        saveScene = EditorGUILayout.ToggleLeft(
            "적용 후 현재 Scene 저장",
            saveScene);
        removeMissingScripts = EditorGUILayout.ToggleLeft(
            "Scene의 Missing Script 제거",
            removeMissingScripts);
        archiveOldTools = EditorGUILayout.ToggleLeft(
            "적용 후 일회성 Tool과 이 Installer를 비활성 보관",
            archiveOldTools);

        EditorGUILayout.Space(12f);

        if (GUILayout.Button(
                "최종 전투 UI 구축",
                GUILayout.Height(46f)))
        {
            ApplyFromWindow();
        }

        EditorGUILayout.Space(12f);
        EditorGUILayout.HelpBox(
            "보존되는 핵심: BattleUIManager, BattleParticipantButtonFactory, " +
            "BodyPartButtonRegistry, BattleTargetButtonRegistry, TargetArrowUI, " +
            "StartBtn의 기존 OnClick, MomentumBar, BattleCameraDirector.\n\n" +
            "캐릭터 상세 화면은 Character Transform 또는 " +
            "CharacterFacingController를 회전시키지 않습니다. " +
            "CharacterCameraPointSet의 CloseCameraPoint와 LookAtPoint를 이용해 " +
            "CM_Pose 카메라만 이동합니다.",
            MessageType.Warning);

        EditorGUILayout.EndScrollView();
    }

    private void ApplyFromWindow()
    {
        if (!EditorUtility.DisplayDialog(
                "최종 전투 UI 구축",
                "현재 Scene의 기존 ReadableBattleHUD를 교체합니다.\n" +
                "계속하시겠습니까?",
                "적용",
                "취소"))
        {
            return;
        }

        try
        {
            bool applied = Apply(
                createBackup,
                saveScene,
                removeMissingScripts,
                archiveOldTools);

            if (!applied)
                return;

            EditorUtility.DisplayDialog(
                "적용 완료",
                "최종 전투 UI 구조를 생성했습니다.\n\n" +
                "Play Mode에서 다음 순서로 확인하세요.\n" +
                "1. 초상화 클릭 → 스킬 서랍\n" +
                "2. 스킬 선택 → 우측 결투 현황으로 복귀\n" +
                "3. 적 초상화 클릭 → 대상 지정\n" +
                "4. 상세 버튼/월드 캐릭터 클릭 → 카메라만 정면 이동\n" +
                "5. Start → TargetArrowUI 연결 유지",
                "확인");

            Close();
        }
        catch (Exception exception)
        {
            Debug.LogException(exception);
            EditorUtility.DisplayDialog(
                "적용 실패",
                exception.ToString(),
                "확인");
        }
    }

    private static bool Apply(
        bool backup,
        bool save,
        bool removeMissing,
        bool archiveTools)
    {
        Scene scene = SceneManager.GetActiveScene();

        if (!scene.IsValid() || !scene.isLoaded)
        {
            Debug.LogError("[FinalBattleUI] 활성 Scene이 없습니다.");
            return false;
        }

        Canvas canvas = FindSceneComponentByName<Canvas>(CanvasName);
        BattleManager battleManager = FindSceneComponent<BattleManager>();
        BattleUIManager uiManager = FindSceneComponent<BattleUIManager>();
        BattleCameraDirector cameraDirector =
            FindSceneComponent<BattleCameraDirector>();
        Camera mainCamera =
            FindSceneComponentByName<Camera>("Main Camera") ?? Camera.main;

        if (canvas == null || battleManager == null || uiManager == null)
        {
            Debug.LogError(
                "[FinalBattleUI] Battle UI Canvas, BattleManager, " +
                "BattleUIManager 중 하나를 찾지 못했습니다.");
            return false;
        }

        if (backup)
            BackupActiveScene(scene);

        Undo.IncrementCurrentGroup();
        int undoGroup = Undo.GetCurrentGroup();
        Undo.SetCurrentGroupName("Build Project Abyss Final Battle UI");

        ConfigureCanvas(canvas);

        Button startButton =
            FindChildComponentByName<Button>(canvas.transform, "StartBtn");
        Slider momentumBar =
            FindChildComponentByName<Slider>(canvas.transform, "MomentumBar");
        TargetArrowUI targetArrow =
            FindChildComponentByName<TargetArrowUI>(
                canvas.transform,
                "TargetArrowUIObject");
        GameObject announcePanel =
            FindChildByName(canvas.transform, "BattleActionAnnouncePanel");

        DetachPreserved(startButton != null ? startButton.gameObject : null, canvas.transform);
        DetachPreserved(momentumBar != null ? momentumBar.gameObject : null, canvas.transform);
        DetachPreserved(targetArrow != null ? targetArrow.gameObject : null, canvas.transform);
        DetachPreserved(announcePanel, canvas.transform);

        DestroyExistingHud(canvas.transform);

        GameObject root = CreateRectObject(RootName, canvas.transform);
        Stretch(root.GetComponent<RectTransform>());
        BattleScreenModeController modeController =
            root.AddComponent<BattleScreenModeController>();

        GameObject persistentLayer =
            CreateRectObject("PersistentTopLayer", root.transform);
        Stretch(persistentLayer.GetComponent<RectTransform>());
        persistentLayer.transform.SetAsFirstSibling();

        TopBarBuildResult topBar = BuildTopStatusBar(
            persistentLayer.transform,
            battleManager,
            momentumBar);

        GameObject defaultLayer =
            CreateRectObject("DefaultBattleLayer", root.transform);
        Stretch(defaultLayer.GetComponent<RectTransform>());

        GameObject skillLayer =
            CreateRectObject("SkillSelectionLayer", root.transform);
        Stretch(skillLayer.GetComponent<RectTransform>());
        CanvasGroup skillGroup = skillLayer.AddComponent<CanvasGroup>();

        GameObject detailLayer =
            CreateRectObject("CharacterDetailLayer", root.transform);
        Stretch(detailLayer.GetComponent<RectTransform>());
        CanvasGroup detailGroup = detailLayer.AddComponent<CanvasGroup>();

        BattleCharacterDetailPanelUI detailPanel =
            BuildCharacterDetailLayer(
                detailLayer.transform,
                detailGroup,
                modeController,
                cameraDirector);

        SkillSelectPanelUI skillPanel =
            BuildSkillSelectionLayer(
                skillLayer.transform,
                skillGroup,
                modeController);

        DefaultLayerBuildResult defaultUi =
            BuildDefaultBattleLayer(
                defaultLayer.transform,
                startButton,
                targetArrow,
                detailPanel);

        if (announcePanel != null)
        {
            announcePanel.transform.SetParent(root.transform, false);
            RectTransform announceRect =
                announcePanel.transform as RectTransform;

            if (announceRect != null)
            {
                SetAnchors(
                    announceRect,
                    new Vector2(0.24f, 0.39f),
                    new Vector2(0.76f, 0.61f));
            }

            announcePanel.transform.SetAsLastSibling();
        }

        modeController.Configure(
            defaultLayer,
            skillLayer,
            detailLayer,
            new[] { persistentLayer });

        WireRuntimeManagers(
            uiManager,
            skillPanel,
            defaultUi.PlayerTemplate,
            defaultUi.EnemyTemplate,
            defaultUi.PlayerColumn,
            defaultUi.EnemyColumn,
            targetArrow,
            defaultUi.ArrowLayer,
            canvas,
            battleManager);

        BuildWorldCharacterUi(
            battleManager,
            uiManager,
            detailPanel,
            mainCamera);

        if (removeMissing)
            RemoveMissingScripts(scene);

        EditorUtility.SetDirty(canvas);
        EditorUtility.SetDirty(uiManager);
        EditorSceneManager.MarkSceneDirty(scene);

        if (save && !string.IsNullOrWhiteSpace(scene.path))
            EditorSceneManager.SaveScene(scene);

        WriteApplicationMarker(scene.path);

        Undo.CollapseUndoOperations(undoGroup);

        if (archiveTools)
            ScheduleToolArchive();

        Debug.Log(
            "[FinalBattleUI] 최종 전투 UI 구축 완료. " +
            "TargetArrowUI는 기존 ActionSlot/Clash 계산을 그대로 사용합니다.");

        return true;
    }

    private static void ConfigureCanvas(Canvas canvas)
    {
        CanvasScaler scaler = canvas.GetComponent<CanvasScaler>();

        if (scaler == null)
            scaler = Undo.AddComponent<CanvasScaler>(canvas.gameObject);

        scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
        scaler.referenceResolution = new Vector2(1920f, 1080f);
        scaler.screenMatchMode = CanvasScaler.ScreenMatchMode.MatchWidthOrHeight;
        scaler.matchWidthOrHeight = 0.5f;
    }

    private static TopBarBuildResult BuildTopStatusBar(
        Transform parent,
        BattleManager battleManager,
        Slider preservedMomentum)
    {
        GameObject root = CreatePanel(
            "TopStatusBar",
            parent,
            PanelColor,
            new Vector2(0.018f, 0.915f),
            new Vector2(0.72f, 0.99f));

        BattleTopStatusBarUI presenter =
            root.AddComponent<BattleTopStatusBarUI>();

        TMP_Text turn = CreateText(
            "TurnText",
            root.transform,
            "턴\n01",
            23f,
            TextAlignmentOptions.Center,
            new Vector2(0.01f, 0.08f),
            new Vector2(0.12f, 0.92f));

        TMP_Text momentum = CreateText(
            "MomentumText",
            root.transform,
            "기세 0 · 균형",
            23f,
            TextAlignmentOptions.Left,
            new Vector2(0.15f, 0.51f),
            new Vector2(0.48f, 0.95f));

        Slider slider = preservedMomentum;

        if (slider == null)
            slider = CreateSlider("MomentumBar", root.transform);
        else
            slider.transform.SetParent(root.transform, false);

        SetAnchors(
            slider.transform as RectTransform,
            new Vector2(0.15f, 0.14f),
            new Vector2(0.58f, 0.47f));

        TMP_Text light = CreateText(
            "LightText",
            root.transform,
            "빛\n0/0",
            22f,
            TextAlignmentOptions.Center,
            new Vector2(0.61f, 0.08f),
            new Vector2(0.74f, 0.92f));

        TMP_Text enemy = CreateText(
            "EnemyText",
            root.transform,
            "적\n0/0",
            22f,
            TextAlignmentOptions.Center,
            new Vector2(0.76f, 0.08f),
            new Vector2(0.89f, 0.92f));

        TMP_Text wave = CreateText(
            "WaveText",
            root.transform,
            "전투 준비",
            18f,
            TextAlignmentOptions.Center,
            new Vector2(0.89f, 0.08f),
            new Vector2(0.99f, 0.92f));

        wave.color = new Color(0.78f, 0.83f, 0.90f, 1f);

        presenter.Configure(
            battleManager,
            turn,
            momentum,
            light,
            enemy,
            slider);

        return new TopBarBuildResult
        {
            Root = root,
            Presenter = presenter,
            MomentumBar = slider
        };
    }

    private static DefaultLayerBuildResult BuildDefaultBattleLayer(
        Transform parent,
        Button preservedStart,
        TargetArrowUI preservedArrow,
        BattleCharacterDetailPanelUI detailPanel)
    {
        GameObject overview = CreatePanel(
            "ClashOverviewPanel",
            parent,
            PanelColor,
            new Vector2(0.685f, 0.36f),
            new Vector2(0.985f, 0.895f));

        CreateText(
            "Title",
            overview.transform,
            "전체 결투 현황",
            25f,
            TextAlignmentOptions.Left,
            new Vector2(0.04f, 0.88f),
            new Vector2(0.96f, 0.98f));

        CreateText(
            "PlayerSideLabel",
            overview.transform,
            "아군 행동",
            17f,
            TextAlignmentOptions.Center,
            new Vector2(0.02f, 0.80f),
            new Vector2(0.31f, 0.88f));

        CreateText(
            "EnemySideLabel",
            overview.transform,
            "적 대상",
            17f,
            TextAlignmentOptions.Center,
            new Vector2(0.69f, 0.80f),
            new Vector2(0.98f, 0.88f));

        GameObject arrowLayer =
            CreateRectObject("ClashArrowLayer", overview.transform);
        SetAnchors(
            arrowLayer.GetComponent<RectTransform>(),
            new Vector2(0.25f, 0.08f),
            new Vector2(0.75f, 0.80f));
        arrowLayer.transform.SetAsFirstSibling();

        TargetArrowUI targetArrow = preservedArrow;

        if (targetArrow == null)
        {
            GameObject arrowObject =
                CreateRectObject("TargetArrowUIObject", arrowLayer.transform);
            Stretch(arrowObject.GetComponent<RectTransform>());
            targetArrow = arrowObject.AddComponent<TargetArrowUI>();
        }
        else
        {
            targetArrow.transform.SetParent(arrowLayer.transform, false);
            Stretch(targetArrow.transform as RectTransform);
        }

        RectTransform playerColumn =
            CreatePortraitColumn(
                "PlayerPortraitColumn",
                overview.transform,
                new Vector2(0.025f, 0.08f),
                new Vector2(0.29f, 0.80f));

        RectTransform enemyColumn =
            CreatePortraitColumn(
                "EnemyPortraitColumn",
                overview.transform,
                new Vector2(0.71f, 0.08f),
                new Vector2(0.975f, 0.80f));

        BodyPartButton playerTemplate =
            CreatePortraitTemplate(
                "PlayerPortraitTemplate",
                playerColumn,
                detailPanel,
                new Color(0.08f, 0.30f, 0.50f, 1f));

        BodyPartButton enemyTemplate =
            CreatePortraitTemplate(
                "EnemyPortraitTemplate",
                enemyColumn,
                detailPanel,
                new Color(0.48f, 0.12f, 0.12f, 1f));

        CreateText(
            "OverviewHint",
            overview.transform,
            "초상화: 행동/대상 선택   ·   i: 상세 보기",
            15f,
            TextAlignmentOptions.Center,
            new Vector2(0.04f, 0.01f),
            new Vector2(0.96f, 0.07f));

        Button startButton = preservedStart;

        if (startButton == null)
        {
            startButton = CreateButton(
                "StartBtn",
                parent,
                "START",
                34f,
                new Vector2(0.76f, 0.075f),
                new Vector2(0.965f, 0.165f),
                new Color(0.04f, 0.15f, 0.27f, 0.98f));
        }
        else
        {
            startButton.transform.SetParent(parent, false);
            SetAnchors(
                startButton.transform as RectTransform,
                new Vector2(0.76f, 0.075f),
                new Vector2(0.965f, 0.165f));

            TMP_Text label =
                startButton.GetComponentInChildren<TMP_Text>(true);

            if (label != null)
            {
                label.text = "START";
                label.fontSize = 34f;
            }
        }

        CreateText(
            "StartHint",
            parent,
            "모든 행동과 대상을 확인한 뒤 전투를 시작합니다.",
            16f,
            TextAlignmentOptions.Center,
            new Vector2(0.72f, 0.03f),
            new Vector2(0.995f, 0.07f));

        return new DefaultLayerBuildResult
        {
            Overview = overview,
            PlayerColumn = playerColumn,
            EnemyColumn = enemyColumn,
            PlayerTemplate = playerTemplate,
            EnemyTemplate = enemyTemplate,
            ArrowLayer = arrowLayer.GetComponent<RectTransform>(),
            TargetArrow = targetArrow,
            StartButton = startButton
        };
    }

    private static SkillSelectPanelUI BuildSkillSelectionLayer(
        Transform parent,
        CanvasGroup group,
        BattleScreenModeController modeController)
    {
        GameObject surface = CreatePanel(
            "SkillDrawerPanel",
            parent,
            new Color(0.015f, 0.025f, 0.045f, 0.88f),
            new Vector2(0.015f, 0.08f),
            new Vector2(0.635f, 0.895f));

        SkillSelectPanelUI panel =
            surface.AddComponent<SkillSelectPanelUI>();
        ActionSlotSelectorUI slotSelector =
            surface.AddComponent<ActionSlotSelectorUI>();

        TMP_Text header = CreateText(
            "SlotHeaderText",
            surface.transform,
            "행동 슬롯",
            25f,
            TextAlignmentOptions.Left,
            new Vector2(0.025f, 0.91f),
            new Vector2(0.76f, 0.985f));

        TMP_Text help = CreateText(
            "HelpText",
            surface.transform,
            "행동 유형을 열고 스킬을 선택하세요.",
            17f,
            TextAlignmentOptions.Left,
            new Vector2(0.025f, 0.855f),
            new Vector2(0.82f, 0.91f));

        Button close = CreateButton(
            "CloseButton",
            surface.transform,
            "ESC  뒤로",
            18f,
            new Vector2(0.84f, 0.905f),
            new Vector2(0.98f, 0.975f),
            new Color(0.18f, 0.06f, 0.06f, 0.95f));

        GameObject drawerRowObject =
            CreateRectObject("DrawerRow", surface.transform);
        RectTransform drawerRow = drawerRowObject.GetComponent<RectTransform>();
        SetAnchors(
            drawerRow,
            new Vector2(0.02f, 0.19f),
            new Vector2(0.98f, 0.84f));

        HorizontalLayoutGroup rowLayout =
            drawerRowObject.AddComponent<HorizontalLayoutGroup>();
        rowLayout.spacing = 10f;
        rowLayout.childAlignment = TextAnchor.UpperLeft;
        rowLayout.childControlWidth = true;
        rowLayout.childForceExpandWidth = true;
        rowLayout.childControlHeight = false;
        rowLayout.childForceExpandHeight = false;

        List<SkillDrawerCategoryUI> drawers = new();
        drawers.Add(CreateSkillDrawer(
            "NormalDrawer",
            drawerRow,
            ActionType.NormalAttack,
            "일반공격",
            new Color(0.06f, 0.28f, 0.48f, 1f)));
        drawers.Add(CreateSkillDrawer(
            "DuelDrawer",
            drawerRow,
            ActionType.Duel,
            "결투",
            new Color(0.48f, 0.09f, 0.08f, 1f)));
        drawers.Add(CreateSkillDrawer(
            "PreparationDrawer",
            drawerRow,
            ActionType.Preparation,
            "도사림",
            new Color(0.04f, 0.38f, 0.31f, 1f)));
        drawers.Add(CreateSkillDrawer(
            "PrestigeDrawer",
            drawerRow,
            ActionType.Prestige,
            "위세",
            new Color(0.42f, 0.23f, 0.04f, 1f)));

        CreateText(
            "SelectionGuide",
            surface.transform,
            "스킬 선택 후 우측 결투 현황으로 돌아가 적 초상화를 선택합니다.",
            20f,
            TextAlignmentOptions.Center,
            new Vector2(0.12f, 0.055f),
            new Vector2(0.88f, 0.14f));

        slotSelector.ConfigureFallbackStyle(close);

        panel.Configure(
            group,
            modeController,
            header,
            help,
            close,
            slotSelector,
            drawers.ToArray());

        return panel;
    }

    private static SkillDrawerCategoryUI CreateSkillDrawer(
        string name,
        RectTransform parent,
        ActionType actionType,
        string title,
        Color accent)
    {
        GameObject column =
            CreateRectObject(name, parent);
        LayoutElement columnLayout =
            column.AddComponent<LayoutElement>();
        columnLayout.flexibleWidth = 1f;
        columnLayout.preferredWidth = 250f;
        columnLayout.preferredHeight = 650f;

        VerticalLayoutGroup vertical =
            column.AddComponent<VerticalLayoutGroup>();
        vertical.spacing = 0f;
        vertical.childControlWidth = true;
        vertical.childForceExpandWidth = true;
        vertical.childControlHeight = false;
        vertical.childForceExpandHeight = false;

        Button header = CreateButtonWithLayout(
            "HeaderButton",
            column.transform,
            title,
            24f,
            64f,
            accent);

        TMP_Text label =
            header.GetComponentInChildren<TMP_Text>(true);

        GameObject drawer =
            CreatePanelWithLayout(
                "DrawerBody",
                column.transform,
                PanelSoftColor,
                0f);

        LayoutElement drawerLayout = drawer.GetComponent<LayoutElement>();
        CanvasGroup drawerGroup = drawer.AddComponent<CanvasGroup>();
        drawer.AddComponent<RectMask2D>();

        GameObject contentObject =
            CreateRectObject("Content", drawer.transform);
        RectTransform content = contentObject.GetComponent<RectTransform>();
        content.anchorMin = new Vector2(0f, 1f);
        content.anchorMax = new Vector2(1f, 1f);
        content.pivot = new Vector2(0.5f, 1f);
        content.anchoredPosition = Vector2.zero;
        content.sizeDelta = new Vector2(0f, 520f);

        VerticalLayoutGroup contentLayout =
            contentObject.AddComponent<VerticalLayoutGroup>();
        contentLayout.padding = new RectOffset(8, 8, 8, 8);
        contentLayout.spacing = 8f;
        contentLayout.childControlWidth = true;
        contentLayout.childForceExpandWidth = true;
        contentLayout.childControlHeight = false;
        contentLayout.childForceExpandHeight = false;

        BattleSkillCardButtonUI cardTemplate =
            CreateSkillCardTemplate(content, accent);

        SkillDrawerCategoryUI controller =
            column.AddComponent<SkillDrawerCategoryUI>();
        controller.Configure(
            actionType,
            header,
            label,
            drawer.GetComponent<RectTransform>(),
            drawerLayout,
            drawerGroup,
            content,
            cardTemplate,
            500f);

        return controller;
    }

    private static BattleSkillCardButtonUI CreateSkillCardTemplate(
        Transform parent,
