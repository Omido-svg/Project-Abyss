    private static ScrollBuildResult BuildScrollArea(
        string name,
        Transform parent,
        Vector2 min,
        Vector2 max)
    {
        GameObject root = CreatePanel(
            name,
            parent,
            PanelSoftColor,
            min,
            max);

        ScrollRect scroll = root.AddComponent<ScrollRect>();
        scroll.horizontal = false;
        scroll.vertical = true;
        scroll.movementType = ScrollRect.MovementType.Clamped;

        GameObject viewportObject =
            CreateRectObject("Viewport", root.transform);
        RectTransform viewport = viewportObject.GetComponent<RectTransform>();
        Stretch(viewport);
        viewportObject.AddComponent<Image>().color = Color.clear;
        viewportObject.AddComponent<RectMask2D>();

        GameObject contentObject =
            CreateRectObject("Content", viewportObject.transform);
        RectTransform content = contentObject.GetComponent<RectTransform>();
        content.anchorMin = new Vector2(0f, 1f);
        content.anchorMax = new Vector2(1f, 1f);
        content.pivot = new Vector2(0.5f, 1f);
        content.anchoredPosition = Vector2.zero;
        content.sizeDelta = Vector2.zero;

        VerticalLayoutGroup layout =
            contentObject.AddComponent<VerticalLayoutGroup>();
        layout.padding = new RectOffset(8, 8, 8, 8);
        layout.spacing = 7f;
        layout.childControlWidth = true;
        layout.childForceExpandWidth = true;
        layout.childControlHeight = false;
        layout.childForceExpandHeight = false;

        ContentSizeFitter fitter =
            contentObject.AddComponent<ContentSizeFitter>();
        fitter.verticalFit = ContentSizeFitter.FitMode.PreferredSize;

        scroll.viewport = viewport;
        scroll.content = content;

        return new ScrollBuildResult
        {
            Root = root,
            Viewport = viewport,
            Content = content
        };
    }

    private static Slider CreateSlider(string name, Transform parent)
    {
        GameObject root = CreateRectObject(name, parent);
        Slider slider = root.AddComponent<Slider>();
        slider.direction = Slider.Direction.LeftToRight;

        Image background = CreateImage(
            "Background",
            root.transform,
            new Color(0.10f, 0.12f, 0.15f, 1f),
            Vector2.zero,
            Vector2.one);

        Image fill = CreateImage(
            "Fill",
            root.transform,
            AccentColor,
            new Vector2(0f, 0.18f),
            new Vector2(1f, 0.82f));

        slider.fillRect = fill.rectTransform;
        slider.targetGraphic = background;
        slider.interactable = false;
        return slider;
    }

    private static GameObject CreatePanel(
        string name,
        Transform parent,
        Color color,
        Vector2 min,
        Vector2 max)
    {
        GameObject root = CreateRectObject(name, parent);
        Image image = root.AddComponent<Image>();
        image.color = color;
        image.raycastTarget = true;
        SetAnchors(root.GetComponent<RectTransform>(), min, max);

        Outline outline = root.AddComponent<Outline>();
        outline.effectColor = BorderColor;
        outline.effectDistance = new Vector2(1f, -1f);
        return root;
    }

    private static GameObject CreatePanelWithLayout(
        string name,
        Transform parent,
        Color color,
        float preferredHeight)
    {
        GameObject root = CreateRectObject(name, parent);
        Image image = root.AddComponent<Image>();
        image.color = color;
        LayoutElement layout = root.AddComponent<LayoutElement>();
        layout.preferredHeight = preferredHeight;
        return root;
    }

    private static Image CreateImage(
        string name,
        Transform parent,
        Color color,
        Vector2 min,
        Vector2 max)
    {
        GameObject root = CreateRectObject(name, parent);
        Image image = root.AddComponent<Image>();
        image.color = color;
        SetAnchors(root.GetComponent<RectTransform>(), min, max);
        return image;
    }

    private static TMP_Text CreateText(
        string name,
        Transform parent,
        string value,
        float size,
        TextAlignmentOptions alignment,
        Vector2 min,
        Vector2 max)
    {
        GameObject root = CreateRectObject(name, parent);
        TextMeshProUGUI text = root.AddComponent<TextMeshProUGUI>();
        text.text = value;
        text.fontSize = size;
        text.alignment = alignment;
        text.color = Color.white;
        text.richText = true;
        text.raycastTarget = false;
        text.overflowMode = TextOverflowModes.Ellipsis;
        SetAnchors(root.GetComponent<RectTransform>(), min, max);
        return text;
    }

    private static Button CreateButton(
        string name,
        Transform parent,
        string label,
        float fontSize,
        Vector2 min,
        Vector2 max,
        Color color)
    {
        GameObject root = CreateRectObject(name, parent);
        Image image = root.AddComponent<Image>();
        image.color = color;
        Button button = root.AddComponent<Button>();
        button.targetGraphic = image;
        SetAnchors(root.GetComponent<RectTransform>(), min, max);

        TMP_Text text = CreateText(
            "Label",
            root.transform,
            label,
            fontSize,
            TextAlignmentOptions.Center,
            Vector2.zero,
            Vector2.one);
        text.overflowMode = TextOverflowModes.Overflow;
        return button;
    }

    private static Button CreateButtonWithLayout(
        string name,
        Transform parent,
        string label,
        float fontSize,
        float preferredHeight,
        Color color)
    {
        GameObject root = CreateRectObject(name, parent);
        Image image = root.AddComponent<Image>();
        image.color = color;
        Button button = root.AddComponent<Button>();
        button.targetGraphic = image;
        LayoutElement layout = root.AddComponent<LayoutElement>();
        layout.preferredHeight = preferredHeight;

        TMP_Text text = CreateText(
            "Label",
            root.transform,
            label,
            fontSize,
            TextAlignmentOptions.Center,
            Vector2.zero,
            Vector2.one);
        text.overflowMode = TextOverflowModes.Overflow;
        return button;
    }

    private static GameObject CreateRectObject(
        string name,
        Transform parent)
    {
        GameObject root =
            new(name, typeof(RectTransform));
        Undo.RegisterCreatedObjectUndo(root, "Create " + name);
        root.transform.SetParent(parent, false);
        RectTransform rect = root.GetComponent<RectTransform>();
        rect.localScale = Vector3.one;
        rect.localRotation = Quaternion.identity;
        return root;
    }

    private static void SetAnchors(
        RectTransform rect,
        Vector2 min,
        Vector2 max)
    {
        if (rect == null)
            return;

        rect.anchorMin = min;
        rect.anchorMax = max;
        rect.offsetMin = Vector2.zero;
        rect.offsetMax = Vector2.zero;
        rect.localScale = Vector3.one;
    }

    private static void Stretch(RectTransform rect)
    {
        SetAnchors(rect, Vector2.zero, Vector2.one);
    }

    private static void DetachPreserved(
        GameObject target,
        Transform temporaryParent)
    {
        if (target == null)
            return;

        Undo.SetTransformParent(
            target.transform,
            temporaryParent,
            "Preserve " + target.name);
    }

    private static void DestroyExistingHud(Transform canvas)
    {
        foreach (string name in new[] { OldHudName, RootName })
        {
            GameObject target = FindChildByName(canvas, name);

            if (target != null)
                Undo.DestroyObjectImmediate(target);
        }
    }

    private static void RemoveMissingScripts(Scene scene)
    {
        int removed = 0;

        foreach (GameObject root in scene.GetRootGameObjects())
        {
            foreach (Transform transform in
                     root.GetComponentsInChildren<Transform>(true))
            {
                removed +=
                    GameObjectUtility.RemoveMonoBehavioursWithMissingScript(
                        transform.gameObject);
            }
        }

        if (removed > 0)
            Debug.Log($"[FinalBattleUI] Missing Script {removed}개 제거.");
    }

    private static void BackupActiveScene(Scene scene)
    {
        if (string.IsNullOrWhiteSpace(scene.path))
            return;

        string folder = "Assets/5. Scenes/_UI_Backups";
        Directory.CreateDirectory(folder);

        string fileName =
            $"{scene.name}_before_FinalBattleUI_" +
            $"{DateTime.Now:yyyyMMdd_HHmmss}.unity";

        string path = Path.Combine(folder, fileName).Replace('\\', '/');
        EditorSceneManager.SaveScene(scene, path, true);
        AssetDatabase.Refresh();
        Debug.Log($"[FinalBattleUI] Scene backup: {path}");
    }

    private static void WriteApplicationMarker(string scenePath)
    {
        string folder = "Assets/_ProjectAbyssArchive/UIApplyReports";
        Directory.CreateDirectory(folder);

        string path = Path.Combine(
            folder,
            $"FinalBattleUI_{DateTime.Now:yyyyMMdd_HHmmss}.txt");

        File.WriteAllText(
            path,
            "PROJECT_ABYSS_FINAL_BATTLE_UI_APPLIED\n" +
            $"AppliedAt: {DateTime.Now:O}\n" +
            $"Scene: {scenePath}\n" +
            "TargetArrowUI: reused\n" +
            "ClashOverview: horizontal left-to-right\n" +
            "SkillPanel: four animated drawers\n" +
            "CharacterDetail: camera-only front focus\n" +
            "WorldEnemyPlate: name/currentHP/maxHP\n");

        AssetDatabase.Refresh();
    }

    private static void ScheduleToolArchive()
    {
        EditorApplication.delayCall += () =>
        {
            try
            {
                string folder =
                    "Assets/_ProjectAbyssArchive/DisabledEditorTools/" +
                    DateTime.Now.ToString("yyyyMMdd_HHmmss");

                Directory.CreateDirectory(folder);

                List<string> paths = new(OneShotToolPaths);
                ProjectAbyssFinalBattleUiInstaller tempWindow =
                    CreateInstance<ProjectAbyssFinalBattleUiInstaller>();
                MonoScript selfScript =
                    MonoScript.FromScriptableObject(tempWindow);
                DestroyImmediate(tempWindow);

                string selfPath = selfScript != null
                    ? AssetDatabase.GetAssetPath(selfScript)
                    : null;

                if (!string.IsNullOrWhiteSpace(selfPath))
                    paths.Add(selfPath);

                foreach (string assetPath in paths.Distinct())
                {
                    if (string.IsNullOrWhiteSpace(assetPath) ||
                        !File.Exists(assetPath))
                    {
                        continue;
                    }

                    string destination = Path.Combine(
                        folder,
                        Path.GetFileName(assetPath) + ".disabled");

                    File.Copy(assetPath, destination, true);
                    AssetDatabase.DeleteAsset(assetPath);
                }

                AssetDatabase.Refresh();
                Debug.Log(
                    "[FinalBattleUI] 일회성 Editor Tool을 비활성 보관했습니다: " +
                    folder);
            }
            catch (Exception exception)
            {
                Debug.LogException(exception);
            }
        };
    }

    private static T FindSceneComponent<T>() where T : Component
    {
        Scene active = SceneManager.GetActiveScene();

        return Resources.FindObjectsOfTypeAll<T>()
            .FirstOrDefault(
                target =>
                    target != null &&
                    target.gameObject.scene == active &&
                    (target.hideFlags & HideFlags.HideAndDontSave) == 0);
    }

    private static T FindSceneComponentByName<T>(string name)
        where T : Component
    {
        Scene active = SceneManager.GetActiveScene();

        return Resources.FindObjectsOfTypeAll<T>()
            .FirstOrDefault(
                target =>
                    target != null &&
                    target.gameObject.scene == active &&
                    string.Equals(
                        target.gameObject.name,
                        name,
                        StringComparison.Ordinal));
    }

    private static GameObject FindSceneObjectByName(string name)
    {
        Scene active = SceneManager.GetActiveScene();

        return Resources.FindObjectsOfTypeAll<GameObject>()
            .FirstOrDefault(
                target =>
                    target != null &&
                    target.scene == active &&
                    string.Equals(
                        target.name,
                        name,
                        StringComparison.Ordinal));
    }

    private static GameObject FindChildByName(
        Transform root,
        string name)
    {
        if (root == null)
            return null;

        foreach (Transform child in root.GetComponentsInChildren<Transform>(true))
        {
            if (string.Equals(child.name, name, StringComparison.Ordinal))
                return child.gameObject;
        }

        return null;
    }

    private static T FindChildComponentByName<T>(
        Transform root,
        string name)
        where T : Component
    {
        GameObject target = FindChildByName(root, name);
        return target != null ? target.GetComponent<T>() : null;
    }

    private static void SetSerialized(
        SerializedObject serializedObject,
        string propertyName,
        UnityEngine.Object value)
    {
        SerializedProperty property =
            serializedObject.FindProperty(propertyName);

        if (property != null)
            property.objectReferenceValue = value;
    }

    private static void SetSerialized(
        SerializedObject serializedObject,
        string propertyName,
        bool value)
    {
        SerializedProperty property =
            serializedObject.FindProperty(propertyName);

        if (property != null)
            property.boolValue = value;
    }

    private static void SetSerialized(
        SerializedObject serializedObject,
        string propertyName,
        int value)
    {
        SerializedProperty property =
            serializedObject.FindProperty(propertyName);

        if (property != null)
            property.intValue = value;
    }

    private static void SetSerialized(
        SerializedObject serializedObject,
        string propertyName,
        float value)
    {
        SerializedProperty property =
            serializedObject.FindProperty(propertyName);

        if (property != null)
            property.floatValue = value;
    }

    private static void SetSerialized(
        SerializedObject serializedObject,
        string propertyName,
        Vector2 value)
    {
        SerializedProperty property =
            serializedObject.FindProperty(propertyName);

        if (property != null)
            property.vector2Value = value;
    }

