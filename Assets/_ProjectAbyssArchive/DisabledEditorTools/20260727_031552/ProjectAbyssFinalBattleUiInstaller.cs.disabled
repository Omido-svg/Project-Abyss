    private static void WireRuntimeManagers(
        BattleUIManager uiManager,
        SkillSelectPanelUI skillPanel,
        BodyPartButton playerTemplate,
        BodyPartButton enemyTemplate,
        RectTransform playerColumn,
        RectTransform enemyColumn,
        TargetArrowUI targetArrow,
        RectTransform arrowLayer,
        Canvas canvas,
        BattleManager battleManager)
    {
        BattleParticipantButtonFactory factory =
            uiManager.GetComponent<BattleParticipantButtonFactory>();

        if (factory == null)
            factory = Undo.AddComponent<BattleParticipantButtonFactory>(uiManager.gameObject);

        BodyPartButtonRegistry partRegistry =
            uiManager.GetComponent<BodyPartButtonRegistry>();

        if (partRegistry == null)
            partRegistry = Undo.AddComponent<BodyPartButtonRegistry>(uiManager.gameObject);

        BattleTargetButtonRegistry targetRegistry =
            uiManager.GetComponent<BattleTargetButtonRegistry>();

        if (targetRegistry == null)
        {
            targetRegistry =
                Undo.AddComponent<BattleTargetButtonRegistry>(uiManager.gameObject);
        }

        factory.Configure(
            playerTemplate,
            enemyTemplate,
            playerColumn,
            enemyColumn);

        SerializedObject factoryObject = new(factory);
        SetSerialized(factoryObject, "removeLegacyButtonsOnBuild", true);
        SetSerialized(factoryObject, "configureGridLayout", true);
        SetSerialized(factoryObject, "cellSize", new Vector2(108f, 94f));
        SetSerialized(factoryObject, "spacing", new Vector2(8f, 8f));
        SetSerialized(factoryObject, "playerColumns", 1);
        SetSerialized(factoryObject, "enemyColumns", 1);
        SetSerialized(factoryObject, "horizontalClashOverview", true);
        SetSerialized(factoryObject, "fitContainerHeightToGeneratedRows", false);
        SetSerialized(factoryObject, "autoPositionContainers", false);
        SetSerialized(factoryObject, "fitContainerWidthToColumns", false);
        factoryObject.ApplyModifiedPropertiesWithoutUndo();

        uiManager.AssignParticipantButtonFactory(factory);

        SerializedObject uiObject = new(uiManager);
        SetSerialized(uiObject, "skillSelectPanel", skillPanel);
        SetSerialized(uiObject, "bodyPartButtonRegistry", partRegistry);
        SetSerialized(uiObject, "participantButtonFactory", factory);
        SetSerialized(uiObject, "targetButtonRegistry", targetRegistry);
        uiObject.ApplyModifiedPropertiesWithoutUndo();

        if (targetArrow != null)
        {
            SerializedObject arrowObject = new(targetArrow);
            SetSerialized(arrowObject, "battleManager", battleManager);
            SetSerialized(arrowObject, "canvas", canvas);
            SetSerialized(arrowObject, "arrowRoot", arrowLayer);
            SetSerialized(arrowObject, "bodyPartButtonRegistry", partRegistry);
            SetSerialized(arrowObject, "targetButtonRegistry", targetRegistry);
            SetSerialized(arrowObject, "lineThickness", 4f);
            SetSerialized(arrowObject, "startPadding", 8f);
            SetSerialized(arrowObject, "endPadding", 8f);
            SetSerialized(arrowObject, "arrowHeadLength", 18f);
            arrowObject.ApplyModifiedPropertiesWithoutUndo();
        }
    }

    private static void BuildWorldCharacterUi(
        BattleManager battleManager,
        BattleUIManager uiManager,
        BattleCharacterDetailPanelUI detailPanel,
        Camera mainCamera)
    {
        GameObject presentationRoot =
            FindSceneObjectByName("[30] PRESENTATION");

        Transform parent =
            presentationRoot != null
                ? presentationRoot.transform
                : battleManager.transform;

        GameObject old = FindChildByName(parent, "Battle World UI");

        if (old != null)
            Undo.DestroyObjectImmediate(old);

        GameObject root = new("Battle World UI");
        Undo.RegisterCreatedObjectUndo(root, "Create Battle World UI");
        root.transform.SetParent(parent, false);

        BattleWorldCharacterPlateManager manager =
            root.AddComponent<BattleWorldCharacterPlateManager>();
        manager.Configure(
            battleManager,
            uiManager,
            detailPanel,
            mainCamera);
    }

    private static RectTransform CreatePortraitColumn(
        string name,
        Transform parent,
        Vector2 min,
        Vector2 max)
    {
        GameObject root = CreateRectObject(name, parent);
        RectTransform rect = root.GetComponent<RectTransform>();
        SetAnchors(rect, min, max);

        GridLayoutGroup grid = root.AddComponent<GridLayoutGroup>();
        grid.cellSize = new Vector2(108f, 94f);
        grid.spacing = new Vector2(8f, 8f);
        grid.constraint = GridLayoutGroup.Constraint.FixedColumnCount;
        grid.constraintCount = 1;
        grid.startAxis = GridLayoutGroup.Axis.Vertical;
        grid.startCorner = GridLayoutGroup.Corner.UpperLeft;
        grid.childAlignment = TextAnchor.UpperCenter;
        return rect;
    }

