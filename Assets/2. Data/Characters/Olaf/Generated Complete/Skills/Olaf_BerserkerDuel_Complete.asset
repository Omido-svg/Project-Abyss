  Description: "\uACF5\uACA9-\uC218\uBE44-\uACF5\uACA9-\uCE5C\uCE58\uB85C\uC758 4\uAD50\uD658
    \uACB0\uD22C. \uC218\uBE44 \uAD74\uB9BC\uC73C\uB85C \uD55C \uCC28\uB840\uB97C
    \uBC84\uD2F0\uACE0 \uB9C8\uC9C0\uB9C9 \uCE5C\uCE58\uB85C \uACB0\uACFC\uB85C \uC2B9\uBD80\uB97C
    \uB4A4\uC9D1\uB294\uB2E4. 4\uAD74\uB9BC\uC758 \uB300\uAC00\uB85C \uD589\uB3D9
    \uC885\uB8CC \uC2DC \uC790\uD574 \uC704\uD5D8\uC774 \uC788\uB2E4."
  Keywords:
  - Name: "\uACB0\uD22C"
    Description: "\uC0C1\uB300 \uC2A4\uD0AC\uACFC \uAD74\uB9BC\uC744 \uB9DE\uBD80\uB52A\uD78C\uB2E4."
  - Name: "\uC218\uBE44 \uAD74\uB9BC"
    Description: "\uB450 \uBC88\uC9F8 \uAD50\uD658\uC5D0\uC11C \uC2B9\uB9AC\uD558\uBA74
      \uD53C\uD574\uB97C 0\uC73C\uB85C \uB9CC\uB4E0\uB2E4."
  - Name: "\uCE5C\uCE58\uB85C"
    Description: "\uB9C8\uC9C0\uB9C9 \uAD74\uB9BC\uC740 3\uC8FC\uC0AC\uC704 \uC870\uD569\uC73C\uB85C
