# Project Abyss - Unity .gitignore
# GitHub/AI inspection friendly version
#
# Goal:
# - Keep Unity-generated/cache/build files out of Git.
# - Keep ALL project-authored Unity serialization data needed to inspect references:
#   .asset / .prefab / .unity / .controller / .playable / .anim / .meta
# - Keep Packages, ProjectSettings, and LocalPackages version-controlled.

# ----------------------------------------------------------------------
# Unity generated/cache folders - do NOT commit
# ----------------------------------------------------------------------
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Memory/recording captures can be huge or sensitive
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ----------------------------------------------------------------------
# Blender backup files
# ----------------------------------------------------------------------
*.blend1
*.blend1.meta

# ----------------------------------------------------------------------
# IDE / editor / OS generated files
# ----------------------------------------------------------------------
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user
.vs/
.gradle/

ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Generated meta files associated only with generated IDE/debug files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash/Mono crash files
sysinfo.txt
mono_crash.*

# ----------------------------------------------------------------------
# Build outputs
# ----------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# ----------------------------------------------------------------------
# Unity generated test/cache content
# ----------------------------------------------------------------------
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/[Ss]ceneDependencyCache*

# ----------------------------------------------------------------------
# Addressables generated/build outputs
# Keep authored AddressableAssetsData assets/settings tracked.
# ----------------------------------------------------------------------
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# ----------------------------------------------------------------------
# Visual Scripting generated caches
# ----------------------------------------------------------------------
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# ----------------------------------------------------------------------
# Project Abyss generated/export folders
# Not needed for source/reference inspection.
# ----------------------------------------------------------------------
/AllDataTXT/
/BattleAnalysis/
/BattleSimulation/

# ======================================================================
# IMPORTANT: explicitly keep project-authored Unity data in Git.
# These are what allow GUID/reference tracing from GitHub.
# ======================================================================

# Assets and Unity serialized authoring data
!/Assets/
!/Assets/**/*.cs
!/Assets/**/*.cs.meta
!/Assets/**/*.asset
!/Assets/**/*.asset.meta
!/Assets/**/*.prefab
!/Assets/**/*.prefab.meta
!/Assets/**/*.unity
!/Assets/**/*.unity.meta
!/Assets/**/*.controller
!/Assets/**/*.controller.meta
!/Assets/**/*.overrideController
!/Assets/**/*.overrideController.meta
!/Assets/**/*.playable
!/Assets/**/*.playable.meta
!/Assets/**/*.anim
!/Assets/**/*.anim.meta
!/Assets/**/*.mask
!/Assets/**/*.mask.meta

# Keep ordinary Unity metadata.
# .meta GUIDs are required to resolve ScriptableObject/Prefab/Scene references.
!/Assets/**/*.meta

# Package configuration must be visible.
!/Packages/
!/Packages/**

# Unity project configuration must be visible.
!/ProjectSettings/
!/ProjectSettings/**

# Project Abyss local UPM packages are source code and must be tracked.
!/LocalPackages/
!/LocalPackages/**

# ----------------------------------------------------------------------
# NOTE
# ----------------------------------------------------------------------
# Do not add broad rules such as:
#   *.asset
#   *.prefab
#   *.unity
#   *.meta
#   /Assets/**
#
# Those would prevent GitHub-side inspection of ScriptableObject, prefab,
# scene and GUID reference graphs.
